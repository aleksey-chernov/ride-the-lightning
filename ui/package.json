{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "api:generate": "orval --config orval.config.ts && prettier --write src/api",
    "lint:fix": "oxlint --fix && stylelint \"src/**/*.css\" --fix"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.58.0",
    "maplibre-gl": "6.14.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "orval": "8.44.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "prettier": {
    "printWidth": 160,
    "singleQuote": true,
    "endOfLine": "lf",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@api/(.*)$",
      "^@shared/(.*)$",
      "^@features/(.*)$",
      "^@app/(.*)$",
      "",
      "^[.]"
    ],
    "importOrderTypeScriptVersion": "6.0.0",
    "tailwindStylesheet": "./src/styles/globals.css",
    "tailwindFunctions": [
      "cn",
      "cva"
    ]
  }
}
